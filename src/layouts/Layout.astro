---
import translations from "../i18n";
import { projects, type Project } from "../data/projects";
import { caseStudyCopy } from "../i18n/case-study";
import { seo, ui, type Locale, type Page } from "../data/seo";
import "../styles/base.css";
import "../styles/fonts.css";
import "../styles/theme.css";

interface Props { page: Page; project?: Project; }
const { page, project } = Astro.props;
const lang = Astro.url.pathname.split("/")[1] as Locale;
const t = translations[lang];
const metadata = project ? {
  title: `${project.title} — ${caseStudyCopy[lang].caseStudy} | Kevin Tim`,
  description: t.projects[project.descriptionKey],
  imageAlt: `${project.title} — ${caseStudyCopy[lang].category[project.category]} · Kevin Tim`,
} : seo[lang][page];
const baseUrl = Astro.site!;
const suffix = project ? `projects/${project.slug}/` : page === "home" ? "" : `${page}/`;
const canonical = new URL(`/${lang}/${suffix}`, baseUrl).href;
const personId = new URL("/#person", baseUrl).href;
const websiteId = new URL("/#website", baseUrl).href;
const image = new URL(project ? `/social/projects/${project.slug}.png` : `/social/${page}.png`, baseUrl).href;
const graph: Record<string, unknown>[] = [
  {
    "@type": "Person", "@id": personId, name: "Kevin Tim",
    jobTitle: "Software Engineer", url: new URL("/en/", baseUrl).href,
    sameAs: ["https://github.com/mylordkaz", "https://www.linkedin.com/in/kevin-timsiline"],
    address: { "@type": "PostalAddress", addressLocality: "Tokyo", addressCountry: "JP" },
  },
  { "@type": "WebSite", "@id": websiteId, url: baseUrl.href, name: "Kevin Tim", inLanguage: ["en", "ja", "fr"], publisher: { "@id": personId } },
  {
    "@type": project ? "WebPage" : page === "about" ? "AboutPage" : page === "projects" ? "CollectionPage" : "WebPage",
    "@id": `${canonical}#webpage`, url: canonical, name: metadata.title,
    description: metadata.description, inLanguage: lang,
    isPartOf: { "@id": websiteId }, about: { "@id": personId },
    ...(page === "about" ? { mainEntity: { "@id": personId } } : {}),
    ...(project ? { mainEntity: { "@id": `${canonical}#project` } } : {}),
  },
];
if (project) {
  graph.push({
    "@type": "CreativeWork", "@id": `${canonical}#project`, url: canonical,
    name: project.title, description: t.projects[project.detailedDescription],
    abstract: t.projects[project.descriptionKey], inLanguage: lang,
    keywords: project.tags.join(", "), image,
    creator: { "@id": personId },
    ...(project.link ? { sameAs: project.link } : {}),
  }, {
    "@type": "BreadcrumbList", "@id": `${canonical}#breadcrumbs`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Kevin Tim", item: new URL(`/${lang}/`, baseUrl).href },
      { "@type": "ListItem", position: 2, name: t.projects.title, item: new URL(`/${lang}/projects/`, baseUrl).href },
      { "@type": "ListItem", position: 3, name: project.title, item: canonical },
    ],
  });
}
if (page === "projects" && !project) {
  graph.push({
    "@type": "ItemList", "@id": `${canonical}#projects`,
    name: t.projects.title, numberOfItems: projects.length,
    itemListElement: [...projects].reverse().map((project, index) => ({
      "@type": "ListItem", position: index + 1,
      item: {
        "@type": "CreativeWork", name: project.title,
        description: t.projects[project.descriptionKey],
        keywords: project.tags.join(", "), creator: { "@id": personId },
        url: new URL(`/${lang}/projects/${project.slug}/`, baseUrl).href,
        ...(project.link ? { sameAs: project.link } : {}),
      },
    })),
  });
}
if (page === "expertise") {
  graph.push({
    "@type": "ItemList", "@id": `${canonical}#services`, name: t.expertise.title,
    itemListElement: t.expertise.offers.map((offer, index) => ({
      "@type": "ListItem", position: index + 1,
      item: { "@type": "Service", name: offer.title, description: offer.description, provider: { "@id": personId } },
    })),
  });
}
---
<!doctype html>
<html lang={lang} class:list={[lang === "ja" ? "font-japanese" : "font-sans"]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      let dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") dark = saved === "dark";
      } catch { /* Storage is optional; the system theme remains usable. */ }
      document.documentElement.classList.toggle("dark", dark);
      document.documentElement.dataset.theme = dark ? "dark" : "light";
    </script>
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="author" content="Kevin Tim" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161614" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    {(["en", "ja", "fr"] as const).map((locale) => (
      <link rel="alternate" hreflang={locale} href={new URL(`/${locale}/${suffix}`, baseUrl).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${suffix}`, baseUrl).href} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="preload" href="/fonts/space-grotesk-v22-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kevin Tim" />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metadata.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={metadata.imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui[lang].skip}</a>
    <slot />
  </body>
</html>
