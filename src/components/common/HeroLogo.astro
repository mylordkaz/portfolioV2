---
import logo from "../../assets/logo.svg";
---
<span
  aria-hidden="true"
  class="hero-logo absolute -left-10 top-1/2 -translate-y-1/2 w-[420px] h-[420px] opacity-[0.08] pointer-events-none select-none"
  style={`--hero-logo: url("${logo.src}")`}
></span>
<style>
  .hero-logo {
    background-color: var(--ink);
    mask-image: var(--hero-logo);
    mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
  }
</style>
